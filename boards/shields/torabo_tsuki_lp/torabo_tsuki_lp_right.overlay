#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <scroll-snap.dtsi> // スクロールスナップ ZMK Scroll Snap Module(https://github.com/kot149/zmk-scroll-snap)を使う
#include "../../../config/layers.dtsi"

&pointing_listener {
    input-processors = 
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_scaler 1 2>; // カーソル移動速度を遅くする

    // left_layerではカーソル遅くする
    slow_cursor {
        layers = <LEFT_L>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_xy_scaler 1 6>;
    };

    // center_layerではカーソル早くする
    fast_cursor {
        layers = <CENTER_L>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_xy_scaler 4 5>;
    };

    scroller {
        layers = <SCROLL_L>;
        input-processors =
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_snap>, // スクロールスナップ機能を入れる
            <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>, // スクロール方向をWindowsに合わせる
            <&zip_scroll_scaler 1 3>; // スクロール速度調整(Soa44では1/8)
    };

    // 高速スクロール
    fast_scroller {
        layers = <RIGHT_L>;
        input-processors =
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_snap>, // スクロールスナップ機能を入れる
            <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>, // スクロール方向をWindowsに合わせる
            <&zip_scroll_scaler 3 2>; // スクロール速度調整(Soa44では1/8)
    };
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};